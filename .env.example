# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Algolia
EXPO_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
EXPO_PUBLIC_ALGOLIA_SEARCH_KEY=your-search-only-api-key
ALGOLIA_ADMIN_KEY=your-admin-api-key

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# PostHog Analytics (analytics is inert until a real key is set here)
# Create a free project at posthog.com → Project Settings → copy the Project API key.
# Host: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU — better for PDPA data residency).
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting (inert until a DSN is set). Create a React Native
# project at sentry.io → copy the DSN. Native crashes need a dev/EAS build.
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# App Config
EXPO_PUBLIC_APP_URL=https://rasa.app
EXPO_PUBLIC_APP_ENV=development
