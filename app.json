{
  "expo": {
    "name": "Rasa",
    "slug": "rasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rasa",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8452A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rasamalaysia.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Rasa needs camera access to take photos of your food.",
        "NSPhotoLibraryUsageDescription": "Rasa needs photo library access to share your food photos.",
        "NSLocationWhenInUseUsageDescription": "Rasa uses your location to find restaurants near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Rasa uses your location to recommend nearby restaurants.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E8452A"
      },
      "package": "com.rasamalaysia.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rasa needs access to your photos to share food experiences."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rasa uses your location to find great food near you."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Rasa saves your monthly recap image to your photos.",
          "savePhotosPermission": "Rasa saves your monthly recap image to your photos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "organization": "rasa-fg",
          "project": "react-native"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
